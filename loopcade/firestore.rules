rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ---------------------------------------------------------------------
    // Spelen: groepen, uitnodigingen en wekelijkse cellen
    // ---------------------------------------------------------------------
    function groupPath(groupId) {
      return /databases/$(database)/documents/groups/$(groupId);
    }

    function isMember(groupId) {
      return signedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isGroupOwner(groupId) {
      return signedIn() && get(groupPath(groupId)).data.ownerUid == request.auth.uid;
    }

    function pad2(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    // Datum (YYYY-MM-DD) van de maandag van de week waarin t valt, volgens UTC.
    function mondayId(t) {
      let monday = t - duration.value(t.dayOfWeek() - 1, 'd');
      return string(monday.year()) + '-' + pad2(monday.month()) + '-' + pad2(monday.day());
    }

    function isWeekId(id) {
      return id is string && id.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // Firestore-regels kennen geen tijdzones. Brussel is UTC+1 of UTC+2, dus beide verschuivingen
    // worden aanvaard. Daardoor is de weekgrens hooguit één uur onscherp (zomer-/wintertijd).
    function isCurrentWeek(id) {
      return isWeekId(id)
        && (id == mondayId(request.time + duration.value(1, 'h'))
          || id == mondayId(request.time + duration.value(2, 'h')));
    }

    // Een week is pas afgesloten als ook de laagste verschuiving de volgende week bereikt heeft;
    // dan kan een speler in die week niet meer schrijven (zie isCurrentWeek).
    function isClosedWeek(id) {
      return isWeekId(id) && id < mondayId(request.time + duration.value(1, 'h'));
    }

    function validName(name, max) {
      return name is string && name.size() >= 1 && name.size() <= max;
    }

    function validToken(id) {
      return id is string && id.size() >= 20 && id.size() <= 64 && id.matches('^[A-Za-z0-9_-]+$');
    }

    function validStart(start) {
      return start is map
        && start.keys().hasOnly(['name', 'lon', 'lat'])
        && validName(start.name, 80)
        && start.lon is number && start.lon >= -180 && start.lon <= 180
        && start.lat is number && start.lat >= -90 && start.lat <= 90;
    }

    function validGroup(data) {
      return data.keys().hasOnly(['schemaVersion', 'name', 'mode', 'ownerUid', 'start', 'firstWeek', 'createdAt'])
        && data.keys().hasAll(['schemaVersion', 'name', 'mode', 'ownerUid', 'start', 'firstWeek', 'createdAt'])
        && data.schemaVersion == 1
        && validName(data.name, 40)
        && data.mode in ['territory']
        && data.ownerUid == request.auth.uid
        && validStart(data.start)
        && isCurrentWeek(data.firstWeek)
        && data.createdAt == request.time;
    }

    function validInviteToken(groupId, token) {
      return validToken(token)
        && get(/databases/$(database)/documents/groups/$(groupId)/invites/$(token)).data.active == true
        && get(/databases/$(database)/documents/groups/$(groupId)/invites/$(token)).data.expiresAt > request.time;
    }

    function validOwnerMember(groupId, uid, data) {
      return data.keys().hasOnly(['uid', 'displayName', 'role', 'joinedAt'])
        && data.role == 'owner'
        // Alleen tegelijk met het aanmaken van de groep zelf.
        && !exists(groupPath(groupId))
        && getAfter(groupPath(groupId)).data.ownerUid == uid;
    }

    function validPlayerMember(groupId, data) {
      return data.keys().hasOnly(['uid', 'displayName', 'role', 'joinedAt', 'inviteId'])
        && data.role == 'player'
        && validInviteToken(groupId, data.inviteId);
    }

    function validMemberCreate(groupId, uid, data) {
      return data.uid == uid
        && validName(data.displayName, 30)
        && data.joinedAt == request.time
        && (validOwnerMember(groupId, uid, data) || validPlayerMember(groupId, data));
    }

    function validPlayerWeek(data, uid, weekId) {
      return data.keys().hasOnly(['uid', 'weekId', 'cells', 'updatedAt'])
        && data.keys().hasAll(['uid', 'weekId', 'cells', 'updatedAt'])
        && data.uid == uid
        && data.weekId == weekId
        && data.cells is list
        && data.cells.size() <= 2500
        && data.updatedAt == request.time;
    }

    function validResult(groupId, weekId, data) {
      return data.keys().hasOnly(['weekId', 'mode', 'winners', 'totalCells', 'standings', 'closedBy', 'closedAt'])
        && data.keys().hasAll(['weekId', 'mode', 'winners', 'totalCells', 'standings', 'closedBy', 'closedAt'])
        && data.weekId == weekId
        && data.mode == get(groupPath(groupId)).data.mode
        && data.winners is list && data.winners.size() <= 50
        && data.totalCells is int && data.totalCells >= 0
        && data.standings is list && data.standings.size() <= 50
        && data.closedBy == request.auth.uid
        && data.closedAt == request.time;
    }

    match /users/{uid} {
      allow read, write: if owns(uid);

      match /activities/{activityId} {
        allow read, write: if owns(uid);
      }

      match /routes/{activityId} {
        allow read, write: if owns(uid);
      }

      // Privé overzicht van de groepen waarvan deze gebruiker lid is (geen collectiegroepquery nodig).
      match /playGroups/{groupId} {
        allow read, write: if owns(uid);
      }
    }

    match /groups/{groupId} {
      // Alleen leden lezen een groep. De groep is na het aanmaken onveranderlijk.
      allow get: if isMember(groupId);
      allow create: if signedIn() && validGroup(request.resource.data);
      allow update, delete: if false;

      match /members/{uid} {
        allow read: if isMember(groupId);
        allow create: if owns(uid) && validMemberCreate(groupId, uid, request.resource.data);
        // Alleen de eigen weergavenaam mag wijzigen.
        allow update: if owns(uid) && isMember(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
          && validName(request.resource.data.displayName, 30);
        // Spelers verlaten de groep zelf; de eigenaar kan spelers verwijderen. De eigenaar blijft altijd lid.
        allow delete: if resource.data.role != 'owner' && (owns(uid) || isGroupOwner(groupId));
      }

      // Het token in het pad is het geheim: alleen wie het kent kan de uitnodiging openen (get),
      // en alleen leden kunnen ze opsommen (list).
      match /invites/{token} {
        allow get: if signedIn();
        allow list: if isMember(groupId);
        allow create: if isGroupOwner(groupId) && validToken(token)
          && request.resource.data.keys().hasOnly(['createdBy', 'createdAt', 'expiresAt', 'active', 'groupName', 'startName', 'ownerName'])
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && request.resource.data.active == true
          && request.resource.data.expiresAt > request.time
          && request.resource.data.expiresAt <= request.time + duration.value(30, 'd')
          && validName(request.resource.data.groupName, 40)
          && validName(request.resource.data.startName, 80)
          && validName(request.resource.data.ownerName, 30);
        // Intrekken: alleen active op false zetten.
        allow update: if isGroupOwner(groupId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active'])
          && request.resource.data.active == false;
        allow delete: if isGroupOwner(groupId);
      }

      // De cellen van één speler in één week. Schrijven kan alleen voor jezelf, als lid,
      // in de lopende week, en cellen kunnen alleen worden toegevoegd.
      match /weeks/{weekId}/players/{uid} {
        allow read: if isMember(groupId);
        allow create: if owns(uid) && isMember(groupId) && isCurrentWeek(weekId)
          && validPlayerWeek(request.resource.data, uid, weekId);
        allow update: if owns(uid) && isMember(groupId) && isCurrentWeek(weekId)
          && validPlayerWeek(request.resource.data, uid, weekId)
          && request.resource.data.cells.hasAll(resource.data.cells);
        // Wie zijn gegevens wil verwijderen, mag dat altijd (ook na het verlaten van de groep).
        allow delete: if owns(uid);
      }

      // Weekuitslagen: één keer aangemaakt nadat de week voorbij is, nooit meer gewijzigd.
      match /results/{weekId} {
        allow read: if isMember(groupId);
        allow create: if isMember(groupId) && isClosedWeek(weekId)
          && weekId >= get(groupPath(groupId)).data.firstWeek
          && validResult(groupId, weekId, request.resource.data);
        allow update, delete: if false;
      }
    }

    // Alles buiten de hierboven genoemde documenten blijft expliciet geweigerd.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
